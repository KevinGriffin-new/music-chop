# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
env/

# OS
.DS_Store

# Media + pipeline outputs never belong in this repo — they live under the
# folder DV2MV_MEDIA points at. These guards catch an accidental run with
# DV2MV_MEDIA set inside the checkout.
*.mp4
*.mov
*.mkv
*.m4v
*.avi
*.dv
*.mp3
*.wav
*.flac
*.m4a
*.aac
catalog_audio/
clips/
cut-*.mp4
order-sync-*.csv
render-*.sh
# stray media/output trees if the app is run from inside the checkout
# (anchored to the repo root so _smoke/ fixtures are unaffected)
/catalog/
/projects/
/sources/
/album-audio/
/cuts/
# timeline-export + catalog artifacts
*.otio
*.fcpxml
histograms.npz

# ...but keep the committed synthetic test fixtures under _smoke/
!_smoke/**
